@model IKimWebConsole.Domain.StockTransfer

<div class="modal fade" id="modal-stock-transfer" tabindex="-1" aria-labelledby="StockTransferModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                @if (Model.Id > 0)
                {
                    <h5 class="modal-title fs-5" id="StockTransferModalLabel">Edit Stock Transfer</h5>
                }
                else
                {
                    <h5 class="modal-title fs-5" id="StockTransferModalLabel">Add Stock Transfer</h5>
                }
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
            </div>
            <div class="modal-body">
                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(m => m.UnitOfMeasureId)
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label>Date</label>
                            <div class="input-group date" id="reservationdate" data-target-input="nearest">
                                @Html.TextBoxFor(m => m.Date, "{0:dd/MM/yyyy}", new { @class = "form-control datetimepicker-input", data_target = "#reservationdate" })
                                <div class="input-group-append" data-target="#reservationdate" data-toggle="datetimepicker">
                                    <div class="input-group-text"> <i class="fa fa-calendar"></i> </div>
                                </div>
                            </div>
                            <span class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col">
                        <label>Item <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.ItemId, ViewBag.Items as List<SelectListItem>, "Select item", new { @class = "form-control" })
                        <span class="text-danger"></span>
                    </div>

                </div>

                <div class="row mb-2">
                    <div class="col">
                        <label>Quantity <span class="text-danger">*</span> </label>
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.Quantity, new { @class = "form-control qty-error", placeholder = "Enter Quantity" })
                            <div class="input-group-append">
                                @Html.TextBoxFor(m => m.UnitOfMeasure, new { @class = "form-control", @readonly = "readonly", style = "max-width:100px;" })
                            </div>
                        </div>
                        <span class="text-danger"></span>
                        <span class="text-danger qty-error"></span>
                        <span class="text-danger unit-error"></span>
                    </div>
                </div>


                @*<div class="row mb-2">
                        <div class="col">
                            <label>Quantity <span class="text-danger">*</span> </label>
                            <div class="input-group">
                                @Html.TextBoxFor(m => m.Quantity, new { @class = "form-control qty-error", placeholder = "Enter Quantity" })
                                <div class="input-group-append">
                                    @Html.DropDownListFor(m => m.UnitOfMeasureId, ViewBag.UnitOfMeasures as List<SelectListItem>, "Unit", new { @class = "form-control" })
                                </div>
                            </div>
                            <span class="text-danger"></span>
                            <span class="text-danger qty-error"></span>
                            <span class="text-danger unit-error"></span>
                        </div>
                    </div>*@

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <a href="javascript:void(0);" class="btn btn-primary btn-submit">Submit</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="@Url.Content("~/custom-js/stock-transfer/create.js")"></script>

@Html.Hidden("NotificationType", (object)ViewBag.NotificationType)
@Html.Hidden("NotificationMsg", (object)ViewBag.NotificationMsg)


