@model IKimWebConsole.Domain.StockLister

<div class="card-header">
    <a href="javascript:void(0)" class="btn btn-primary add-stock-batch float-right">Add Stock</a>
</div>

<div class="card-body">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>
                    Store
                </th>
                <th>
                    Entry Date
                </th>
                <th colspan="3" class="text-center">
                    Action
                </th>
            </tr>
            <tr>
                <th>
                    @Html.TextBoxFor(m => m.SearchCriteria.Store, new { @class = "form-control search-text" })
                </th>
                <th></th>
                <th colspan="3">
                </th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.List != null && Model.List.Count > default(int))
            {
                foreach (var item in Model.List)
                {
                    <tr>
                        <td>@item.Store</td>
                        <td>@item.EntryDate</td>

                        <td class="text-center">
                            <a href="javascript:void(0);" data-id="@item.Id" class="icon-stockItem text-primary" title="Click Here To See The Items"><i class="fas fa-list-alt"></i></a>
                        </td>

                        <td class="text-center">
                            <a href="javascript:void(0);" data-id="@item.Id" class="icon-edit text-info"><i class="fas fa-edit"></i></a>
                        </td>

                        <td class="text-center">
                            <a href="javascript:void(0);" data-id="@item.Id" class="icon-delete text-danger"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td class="text-center text-danger" colspan="5">
                        There is currently no content to display
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="card-footer">
    <div class="row">
        <div class="col-12">
            <div class="row footer-button-section">
                <div class="col-lg-3 col-xl-3">
                    <div class="page-per-size d-flex align-items-center">
                        @Html.DropDownListFor(m => m.Pagination.PageSize, ViewBag.Pagination as List<SelectListItem> ?? new List<SelectListItem>(), new { @class = "form-control search-pagination set-page-size" })
                        <label>entries per page</label>
                    </div>
                </div>
                <div class="col-lg-4 offset-xl-1 col-xl-3 d-flex justify-content-center align-items-center">
                    <div class="showing-entry d-flex align-items-center">
                        <h3>@Model.Pagination.PaginationSummary </h3>
                    </div>
                </div>
                <div class="col-lg-5 col-xl-5">
                    <div class="navigation-tab">
                        <input type="button" value="First" class="btn btn-secondary navigation" data-direction="First" />
                        <input type="button" value="Previous" class="btn btn-secondary navigation" data-direction="Previous" />
                        <label> @Model.Pagination.CurrentPage / @Model.Pagination.TotalPage</label>
                        <input type="button" value="Next" class="btn btn-secondary navigation" data-direction="Next" />
                        <input type="button" value="Last" class="btn btn-secondary navigation" data-direction="Last" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    @Html.HiddenFor(m => m.Pagination.Skip)
    @Html.HiddenFor(m => m.Pagination.TotalRecord)
</div>
<!-- /.card-footer-->

<script src="@Url.Content("~/custom-js/stock/list.js")"></script>

<script>
        window.paginationConfig = {
        pageSize: @Model.Pagination.PageSize,
        totalPage: @Model.Pagination.TotalPage,
        currentPage: @Model.Pagination.CurrentPage,
        skip: @Model.Pagination.Skip,
        };
</script>