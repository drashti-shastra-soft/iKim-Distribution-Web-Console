@model IKimWebConsole.Domain.StockReport
@{
    ViewBag.Title = "Stock Report";
}

<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")">Home</a></li>
                        <li class="breadcrumb-item active">Stock Report</li>
                    </ol>
                </div>
            </div>
        </div>
        <!-- /.container-fluid -->
    </section>
    <section class="content">
        <div class="card">
            @using (Ajax.BeginForm("List", "StockReport", new AjaxOptions() { UpdateTargetId = "divList", InsertionMode = InsertionMode.Replace, LoadingElementId = "loading-element" }, new { @id = "frmList" }))
            {
                <div id="divList">
                    @Html.Action("List", Model)
                </div>
            }
        </div>
    </section>
</div>

