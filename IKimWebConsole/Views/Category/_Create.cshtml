@model IKimWebConsole.Domain.Category

<div class="modal fade" id="modal-category" tabindex="-1" aria-labelledby="ItemModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                @if (Model.Id > 0)
                {
                    <h5 class="modal-title fs-5" id="ItemModalLabel">Edit Category</h5>
                }
                else
                {
                    <h5 class="modal-title fs-5" id="ItemModalLabel">Add Category</h5>
                }
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
            </div>
            <div class="modal-body">
                @Html.HiddenFor(m => m.Id)

                <div class="row mb-2">
                    <div class="col">
                        <label>Name <span class="text-danger">*</span> </label>
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Enter Name" })
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col">
                        <label>Description</label>
                        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", placeholder = "Enter Description", rows = "3" })
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col">
                        <label>Multiply <span class="text-danger">*</span> </label>
                        @Html.TextBoxFor(m => m.Multiply, new { @class = "form-control", placeholder = "Enter Multiply" })
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label for="file">Image</label>
                    <div class="custom-file">
                        <input type="file" class="custom-file-input" id="file" name="file" accept=".jpg,.jpeg,.png" style="padding:3px;" data-toggle="tooltip" data-placement="top" title="Max 2MB" >
                        <label class="custom-file-label" for="file">
                            @(string.IsNullOrEmpty(Model.FileName) ? "Choose file" : Model.FileName)
                        </label>
                    </div>
                </div>

                @*<div class="row mb-2">
                    <div class="col">
                        <label for="CategoryImage" class="form-label"> Image </label>
                        <input class="form-control" type="file" id="file" name="file" accept=".jpg,.jpeg,.png" style="padding:3px;" data-toggle="tooltip" data-placement="top" title="Max 2MB">
                    </div>
                </div>*@


                <div class="row mb-2">
                    <div class="col">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                            <label class="form-check-label" for="isActiveCheck">Is Active?</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <a href="javascript:void(0);" class="btn btn-primary btn-submit">Submit</a>
            </div>
        </div>
    </div>
</div>

<script src="@Url.Content("~/custom-js/category/create.js")"></script>

@Html.Hidden("NotificationType", (object)ViewBag.NotificationType)
@Html.Hidden("NotificationMsg", (object)ViewBag.NotificationMsg)