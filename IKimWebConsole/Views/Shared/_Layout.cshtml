<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title | i'Kim</title>

    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="@Url.Content("~/Content/pluggins/fontawesome/all.min.css")" />

    <!-- Date Range Picker  -->
    <link href="@Url.Content("~/Content/pluggins/daterangepicker/daterangepicker.css")" rel="stylesheet" />

    <!-- Date Range Picker  -->
    <link href="@Url.Content("~/Content/pluggins/daterangepicker/tempusdominus-bootstrap-4.min.css")" rel="stylesheet" />

    <!-- Toastr -->
    <link rel="stylesheet" href="@Url.Content("~/Scripts/plugins/toastr/toastr.min.css")" />

    <!--  dropzone-->
    <link rel="stylesheet" href="@Url.Content("~/Scripts/plugins/dropzone/min/dropzone.min.css")" />

    <!-- Theme style -->
    <link rel="stylesheet" href="@Url.Content("~/Content/dist/adminlte.min.css")">

    <!-- Custom -->
    <link rel="stylesheet" href="@Url.Content("~/Content/css/custom.css")" />

    <!-- jQuery -->
    <script src="@Url.Content("~/Scripts/plugins/jquery/jquery.min.js")"></script>

    <!-- Bootstrap 4 -->
    <script src="@Url.Content("~/Scripts/plugins/bootstrap/bootstrap.bundle.min.js")"></script>

    <!-- Date Range Picker  -->
    <script src="@Url.Content("~/Content/pluggins/daterangepicker/moment.min.js")"></script>

    <!-- Date Range Picker  -->
    <script src="@Url.Content("~/Content/pluggins/daterangepicker/tempusdominus-bootstrap-4.min.js")"></script>

    <!-- Date Range Picker  -->
    <script src="@Url.Content("~/Content/pluggins/daterangepicker/daterangepicker.js")"></script>

    <!-- dropzone  -->
    <script src="@Url.Content("~/Scripts/plugins/dropzone/min/dropzone.min.js")"></script>

    <!-- Toastr -->
    <script src="@Url.Content("~/Scripts/plugins/toastr/toastr.min.js")"></script>

    <!-- AdminLTE App -->
    <script src="@Url.Content("~/Scripts/dist/js/adminlte.min.js")"></script>

    <!-- Unobtrusive -->
    <script src="@Url.Content("~/Scripts/jquery.unobtrusive-ajax.min.js")"></script>

    <!-- Chart Js -->
    <script src="@Url.Content("~/Scripts/plugins/chart/Chart.min.js")"></script>

    <!-- Masking -->
    <script src="@Url.Content("~/Scripts/jquery.mask.min.js")"></script>

    <!-- Custom Notification -->
    <script src="@Url.Content("~/custom-js/layout/custom-notification.js")"></script>

    <!-- Custom Functions -->
    <script src="@Url.Content("~/custom-js/layout/custom-functions.js")"></script>
</head>
<body class="hold-transition sidebar-mini" style="padding-right: 0">
    <!-- Site wrapper -->
    <div class="wrapper">
        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
            </ul>
            <!-- Right navbar links -->
            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </a>
                </li>
            </ul>
        </nav>
        <!-- /.navbar -->
        <!-- Main Sidebar Container -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <!-- Brand Logo -->
            <a href="@Url.Action("Index", "Dashboard")" class="brand-link text-center">
                <img src="@Url.Content("~/Content/assets/img/I'Kim-logo.png")" alt="i'Kim" style="height:50px; width:auto; display:block; margin:0 auto;">
            </a>
            <!-- Sidebar -->
            <div class="sidebar">
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Dashboard")" class="nav-link @(ViewBag.Title == "Dashboard" ? "active" : "")">
                                <i class="nav-icon fas fa-tachometer-alt"></i>
                                <p> Dashboard </p>
                            </a>
                        </li>

                        @{
                            bool isMasterActive = ViewBag.Title == "Store" || ViewBag.Title == "User" || ViewBag.Title == "Category" || ViewBag.Title == "Item" || ViewBag.Title == "Banner" || ViewBag.Title == "Unit Of Measure" || ViewBag.Title == "Vendor";
                        }

                        <li class="nav-item @(isMasterActive ? "menu-open" : "")">
                            <a href="#" class="nav-link @(isMasterActive ? "active" : "")">
                                <i class="nav-icon fas fa-file-alt"></i>
                                <p>
                                    Master
                                    <i class="right fas fa-angle-left"></i>
                                </p>
                            </a>

                            <ul class="nav nav-treeview" style="display: @(isMasterActive ? "block" : "none")">
                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "Store")" class="nav-link @(ViewBag.Title == "Store" ? "active" : "")">
                                        <i class="nav-icon fas fa-store"></i>
                                        <p> Store </p>
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "User")" class="nav-link @(ViewBag.Title == "User" ? "active" : "")">
                                        <i class="nav-icon fas fa-user-circle"></i>
                                        <p> User </p>
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "Category")" class="nav-link @(ViewBag.Title == "Category" ? "active" : "")">
                                        <i class="nav-icon fas fa-chart-pie"></i>
                                        <p> Category </p>
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "Item")" class="nav-link @(ViewBag.Title == "Item" ? "active" : "")">
                                        <i class="nav-icon fas fa-box-open"></i>
                                        <p> Item </p>
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "Banner")" class="nav-link @(ViewBag.Title == "Banner" ? "active" : "")">
                                        <i class="nav-icon fas fa-image"></i>
                                        <p>Banner</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "UnitOfMeasure")" class="nav-link @(ViewBag.Title == "Unit Of Measure" ? "active" : "")">
                                        <i class="nav-icon fas fa-balance-scale"></i>
                                        <p> Unit Of Measure </p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "Vendor")" class="nav-link @(ViewBag.Title == "Vendor" ? "active" : "")">
                                        <i class="nav-icon fas fa-person-booth"></i>
                                        <p> Vendor</p>
                                    </a>
                                </li>

                            </ul>
                        </li>

                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Purchase")" class="nav-link @(ViewBag.Title == "Purchase" ? "active" : "")">
                                <i class="nav-icon far fa-credit-card"></i>
                                <p>Purchase</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Order")" class="nav-link @(ViewBag.Title == "Order" ? "active" : "")">
                                <i class="nav-icon fas fa-cart-plus"></i>
                                <p> Order </p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "PartyOrder")" class="nav-link @(ViewBag.Title == "Party Order" ? "active" : "")">
                                <i class="nav-icon fas fa-glass-cheers"></i>
                                <p> Party Order </p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Stock")" class="nav-link @(ViewBag.Title == "Stock" ? "active" : "")">
                                <i class="nav-icon fas fa-archive"></i>
                                <p> Stock </p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "StockUpdate")" class="nav-link @(ViewBag.Title == "Stock Update" ? "active" : "")">
                                <i class="nav-icon fas fa-sync"></i>
                                <p>Stock Update</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Notification")" class="nav-link @(ViewBag.Title == "Notification" ? "active" : "")">
                                <i class="nav-icon fas fa-bell"></i>
                                <p> Notification </p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="@Url.Action("Index", "StockTransfer")" class="nav-link @(ViewBag.Title == "Stock Transfer" ? "active" : "")">
                                <i class="nav-icon fas fa-dolly-flatbed"></i>
                                <p> Stock Transfer </p>
                            </a>
                        </li>

                        @{
                            bool isReportActive = ViewBag.Title == "Daily Order" || ViewBag.Title == "Stock Report" || ViewBag.Title == "Daily Sales";
                        }

                        <li class="nav-item @(isReportActive ? "menu-open" : "")">
                            <a href="#" class="nav-link @(isReportActive ? "active" : "")">
                                <i class="nav-icon fas fa-file-alt"></i>
                                <p>
                                    Reports
                                    <i class="right fas fa-angle-left"></i>
                                </p>
                            </a>

                            <ul class="nav nav-treeview" style="display: @(isReportActive ? "block" : "none")">
                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "StockReport")" class="nav-link @(ViewBag.Title == "Stock Report" ? "active" : "")">
                                        <i class="nav-icon fas fa-chart-line"></i>
                                        <p> Stock Report</p>
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "DailySales")" class="nav-link @(ViewBag.Title == "Daily Sales" ? "active" : "")">
                                        <i class="nav-icon fas fa-cash-register"></i>
                                        <p> Daily Sales </p>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "ChangePassword")" class="nav-link @(ViewBag.Title == "Change Password" ? "active" : "")">
                                <i class="nav-icon fas fa-unlock-alt"></i>
                                <p> Change Password </p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Logout")" class="nav-link">
                                <i class="nav-icon fas fa-sign-out-alt"></i>
                                <p> Logout </p>
                            </a>
                        </li>
                    </ul>
                </nav>
                <!-- /.sidebar-menu -->
            </div>
            <!-- /.sidebar -->
        </aside>

        @RenderBody()

        <div id="loading-element" class="custom-loader">
            <div class="loader">
                <img src="@Url.Content("~/Content/assets/img/Admin/Loading.gif")" style="height:100px;" />
            </div>
            <br />
        </div>

        <footer class="main-footer">
            <div class="float-right d-none d-sm-block">
                <b>Version</b> 1.0.0
            </div>
            <strong>Copyright &copy; 2025-2026 <a href="javascript:void(0)" style="color: #f76c00">i'Kim</a>.</strong> All rights reserved.
        </footer>

        <!-- Control Sidebar -->
        <aside class="control-sidebar control-sidebar-dark">
            <!-- Control sidebar content goes here -->
        </aside>
        <!-- /.control-sidebar -->
    </div>
    <!-- ./wrapper -->    
</body>
</html>
