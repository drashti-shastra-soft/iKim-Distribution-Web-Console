
@model IKimWebConsole.Domain.ItemLister

@{
    ViewBag.Title = "Stock Update";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .stock-pagination-footer {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    align-items: center;
    width: 100%;
    gap: 12px;
}

.stock-pagination-footer .page-per-size {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 6px;
    min-width: 0;
}

.stock-pagination-footer .page-per-size select {
    width: 70px;
    min-width: 70px;
    height: 38px;
}

.stock-pagination-footer .page-per-size label {
    margin: 0;
    white-space: nowrap;
    font-weight: normal;
}

.stock-pagination-footer .showing-entry {
    text-align: center;
    white-space: nowrap;
}

.stock-pagination-footer .showing-entry h3 {
    margin: 0;
    font-size: 16px;
    font-weight: normal;
}

.stock-pagination-footer .navigation-tab {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
}

.stock-pagination-footer .navigation-tab label {
    margin: 0 2px;
    font-weight: normal;
}

@@media (max-width: 768px) {
    .stock-pagination-footer {
        grid-template-columns: 1fr;
        gap: 14px;
    }

    .stock-pagination-footer .showing-entry {
        text-align: left;
    }

    .stock-pagination-footer .navigation-tab {
        justify-content: flex-start;
        flex-wrap: wrap;
    }
}
</style>

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6"></div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item">
                            <a href="@Url.Action("Index", "Dashboard")">Home</a>
                        </li>
                        <li class="breadcrumb-item active">Stock Items</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="card">
            <div class="card-header">
                <a href="@Url.Action("Index", "StockUpdate")"
                   class="text-reset text-decoration-none"
                   title="Back to Categories">
                    <i class="fa fa-arrow-left"></i>
                </a>
            </div>

            @using (Html.BeginForm( "Items", "StockUpdate", FormMethod.Get, new { id = "frmItems" }))
            {
                @Html.Hidden("categoryId", (object)ViewBag.CategoryId)
                @Html.Hidden("skip", Model.Pagination.Skip, new { id = "Pagination_Skip" })
                <div class="card-body">
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Category</th>
                                <th>Name</th>
                                <th>Current Stock</th>
                                <th>New Stock</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model != null && Model.List != null && Model.List.Count > 0)
                            {
                                foreach (var item in Model.List)
                                {
                                    <tr>
                                        <td>@item.Category</td>
                                        <td>@item.Name</td>
                                        <td>@item.FactoryStock</td>
                                        <td>
                                            <input type="number" id="Item_@item.Id" class="form-control stock-update" data-id="@item.Id" data-current="@(item.FactoryStock ?? 0)" step="any" />
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4"
                                        class="text-center text-danger">
                                        There is currently no content to display
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="card-footer">
                    <div class="stock-pagination-footer">

                        <div class="page-per-size">
                            @Html.DropDownList("pageSize", ViewBag.Pagination as List<SelectListItem> ?? new List<SelectListItem>(), new { @class = "form-control search-pagination" })
                            <label>entries per page</label>
                        </div>
                        <div class="showing-entry"> <h3>@Model.Pagination.PaginationSummary</h3> </div>
                        <div class="navigation-tab">
                            <button type="button" class="btn btn-secondary navigation" data-direction="First"> First </button>
                            <button type="button" class="btn btn-secondary navigation" data-direction="Previous"> Previous </button>
                            <label> @Model.Pagination.CurrentPage / @Model.Pagination.TotalPage </label>
                            <button type="button" class="btn btn-secondary navigation" data-direction="Next"> Next </button>
                            <button type="button" class="btn btn-secondary navigation" data-direction="Last"> Last </button>
                        </div>

                    </div>
                </div>
            }
        </div>
    </section>
</div>

<script>
    window.paginationConfig = {
        pageSize: @Model.Pagination.PageSize,
        totalPage: @Model.Pagination.TotalPage,
        currentPage: @Model.Pagination.CurrentPage,
        skip: @Model.Pagination.Skip
    };
</script>

<script src="@Url.Content("~/custom-js/stock-update/list.js")"></script>

@Html.Hidden("NotificationType", (object)ViewBag.NotificationType)
@Html.Hidden("NotificationMsg", (object)ViewBag.NotificationMsg)
