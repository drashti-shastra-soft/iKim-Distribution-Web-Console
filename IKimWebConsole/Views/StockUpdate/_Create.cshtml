@model IKimWebConsole.Domain.StockUpdate

<div class="modal fade" id="modal-stock-update" tabindex="-1" aria-labelledby="StockUpdateModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fs-5" id="StockUpdateModalLabel">Reason</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
            </div>
            <div class="modal-body">
                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(m => m.ItemId)

                <div class="row mb-2">
                    <div class="col">
                        <label>Reason <span class="text-danger">*</span></label>
                        @Html.TextAreaFor(m => m.Reason, new { @class = "form-control", placeholder = "Enter Reason", rows = "3" })
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col">
                        <span class="text-info"> Note: A valid reason is required when reducing stock.</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <a href="javascript:void(0);" class="btn btn-primary btn-submit">Submit</a>
            </div>
        </div>
    </div>
</div>

<script src="@Url.Content("~/custom-js/stock-update/create.js")"></script>

@Html.Hidden("NotificationType", (object)ViewBag.NotificationType)
@Html.Hidden("NotificationMsg", (object)ViewBag.NotificationMsg)
