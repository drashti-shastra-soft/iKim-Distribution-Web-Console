@model IKimWebConsole.Domain.Data
@{
    ViewBag.Title = "Dashboard";
}
<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0">Dashboard</h1>
                </div><!-- /.col -->
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="#">Home</a></li>
                        <li class="breadcrumb-item active">Dashboard</li>
                    </ol>
                </div><!-- /.col -->
            </div><!-- /.row -->
        </div><!-- /.container-fluid -->
    </div>
    <!-- /.content-header -->
    <!-- Main content -->
    <section class="content">
        <div class="container-fluid">
            <!-- Small boxes (Stat box) -->
            <div class="row">
                <div class="col-lg-4 col-6">
                    <!-- small box -->
                    <div class="small-box bg-info">
                        <div class="inner">
                            <h3>150</h3>

                            <p>New Orders</p>
                        </div>
                        <div class="icon">
                            <i class="ion ion-bag"></i>
                        </div>
                        <a href="#" class="small-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
                    </div>
                </div>
                <!-- ./col -->
                <div class="col-lg-4 col-6">
                    <!-- small box -->
                    <div class="small-box bg-success">
                        <div class="inner">
                            <h3>53<sup style="font-size: 20px">%</sup></h3>

                            <p>Bounce Rate</p>
                        </div>
                        <div class="icon">
                            <i class="ion ion-stats-bars"></i>
                        </div>
                        <a href="#" class="small-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
                    </div>
                </div>
                <!-- ./col -->
                <div class="col-lg-4 col-6">
                    <!-- small box -->
                    <div class="small-box bg-warning">
                        <div class="inner">
                            <h3>44</h3>

                            <p>User Registrations</p>
                        </div>
                        <div class="icon">
                            <i class="ion ion-person-add"></i>
                        </div>
                        <a href="#" class="small-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
                    </div>
                </div>
                <!-- ./col -->
            </div>
            <div class="row">
                <!-- Left col -->
                <section class="col-lg-6 connectedSortable">
                    <!-- Custom tabs (Charts with tabs)-->
                    <div class="card">
                        <div class="card-header">
                            <div class="row align-items-center">
                                <div class="col-md-6">
                                    <h3 class="card-title">
                                        <i class="fas fa-chart-pie mr-1"></i>
                                        Sales
                                    </h3>
                                </div>
                                <div class="col-md-6 text-right">
                                    <div class="form-inline justify-content-end">
                                        @Html.DropDownListFor(m => m.StoreId, ViewBag.Stores as List<SelectListItem>, "Select Store", new { @class = "form-control", style = "width:220px;" })
                                    </div>
                                </div>
                            </div>
                        </div><!-- /.card-header -->
                        <div class="card-body">
                            <div class="tab-content p-0">
                                <div class="chart tab-pane active" id="sales-chart" style="position: relative; height: 300px;">
                                    <canvas id="sales-chart-canvas" height="300" style="height: 300px;"></canvas>
                                </div>
                            </div>
                        </div><!-- /.card-body -->
                    </div>
                    <!-- /.card -->
                </section>
                <!-- /.Left col -->
                <!-- Left col -->
                <section class="col-lg-6 connectedSortable">
                    <!-- Custom tabs (Charts with tabs)-->
                    <div class="card">
                        <div class="card-header">
                            <div class="row align-items-center">
                                <div class="col-md-6">
                                    <h3 class="card-title">
                                        <i class="fas fa-chart-pie mr-1"></i>
                                        Purchase
                                    </h3>
                                </div>
                                <div class="col-md-6 text-right">
                                    <div class="form-inline justify-content-end">
                                        @Html.DropDownListFor(m => m.VendorId, ViewBag.Vendors as List<SelectListItem>, "Select Vendor", new { @class = "form-control" })
                                    </div>
                                </div>
                            </div>
                        </div><!-- /.card-header -->
                        <div class="card-body">
                            <div class="tab-content p-0">
                                <div class="chart tab-pane active" id="purchase-chart" style="position: relative; height: 300px;">
                                    <canvas id="purchase-chart-canvas" height="300" style="height: 300px;"></canvas>
                                </div>
                            </div>
                        </div><!-- /.card-body -->
                    </div>
                    <!-- /.card -->
                </section>
                <!-- /.Left col -->
            </div>
            <div class="row">
                <!-- Left col -->
                <section class="col-lg-6 connectedSortable">
                    <!-- Custom tabs (Charts with tabs)-->
                    <div class="card">
                        <div class="card-header">
                            <div class="row align-items-center">
                                <div class="col-md-6">
                                    <h3 class="card-title">
                                        <i class="fas fa-chart-pie mr-1"></i>
                                        Ingredient Consumption Report
                                    </h3>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-inline justify-content-end">
                                        @Html.DropDownListFor(m => m.ItemId, ViewBag.Items as List<SelectListItem>, "Select Item", new { @class = "form-control" })
                                    </div>
                                </div>
                            </div>

                        </div><!-- /.card-header -->
                        <div class="card-body">
                            <div class="tab-content p-0">
                                <div class="chart tab-pane active" id="ingredient-consumption-report" style="position: relative; height: 300px;">
                                    <canvas id="ingredient-chart-canvas" height="300" style="height: 300px;"></canvas>
                                </div>
                            </div>
                        </div><!-- /.card-body -->
                    </div>
                    <!-- /.card -->
                </section>
            </div>
            <!-- /.row (main row) -->
        </div><!-- /.container-fluid -->
    </section>
    <!-- /.content -->
</div>
<!-- /.content-wrapper -->



<script>
    var salesChart;
    var purchaseChart;
    var ingredientChart;

    $(document).ready(function () {
        fnSalesChart(0);

        $('#StoreId').change(function () {
            var storeId = $(this).val();
            if (parseInt(storeId) > 0) {
                fnSalesChart(parseInt(storeId));
            } else {
                fnSalesChart(0);
            }
        });

        fnPurchaseChart(0);

        $('#VendorId').change(function () {
            var vendorId = $(this).val();
            if (parseInt(vendorId) > 0) {
                fnPurchaseChart(parseInt(vendorId));
            } else {
                fnPurchaseChart(0);
            }
        });

        fnIngredientConsumptionReport(0);

        $('#ItemId').change(function () {
            var itemId = $(this).val();
            if (parseInt(itemId) > 0) {
                fnIngredientConsumptionReport(itemId);
            } else {
                fnIngredientConsumptionReport(0);
            }
        });


    });

    function fnSalesChart(storeId) {
        $.ajax({
            url: '/Dashboard/SalesChart',
            type: 'GET',
            data: { storeId: storeId },
            success: function (response) {
                if (response) {
                    if (response.IsSuccess) {
                        fnBindChart(response);
                    } else {
                        showToastr('error', 'Error accured while fetching data!');
                    }
                }
            },
            error: function () {
                showToastr('error', 'Error fetching Dashboard details.');
            }
        });
    }

    function fnPurchaseChart(vendorId) {
        $.ajax({
            url: '/Dashboard/PurchaseChart',
            type: 'GET',
            data: { vendorId: vendorId },
            success: function (response) {
                if (response) {
                    if (response.IsSuccess) {
                        fnPurchaseBindChart(response);
                    } else {
                        showToastr('error', 'Error accured while fetching data!');
                    }
                }
            },
            error: function () {
                showToastr('error', 'Error fetching Dashboard details.');
            }
        });
    }



    function fnBindChart(response) {
        var list = response.Data;
        var months = [];
        var sales = [];

        $.each(list, function (i, item) {
            months.push(item.MonthString);
            sales.push(item.Sales);
        });

        var ctx = document.getElementById('sales-chart-canvas').getContext('2d');

        // Destroy old chart if it exists
        if (salesChart) {
            salesChart.destroy();
        }

        // Create new chart
        salesChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: months,
                datasets: [{
                    label: 'Sales',
                    data: sales,
                    backgroundColor: '#17a2b8'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: false,
                        ticks: {
                            stepSize: 10000,
                            callback: function (value) {
                                return value.toLocaleString();
                            }
                        }
                    }
                }
            }
        });
    }

    function fnPurchaseBindChart(response) {
        var list = response.Data;
        var months = [];
        var purchase = [];

        $.each(list, function (i, item) {
            months.push(item.MonthString);
            purchase.push(item.Purchase);
        });

        var ctx = document.getElementById('purchase-chart-canvas').getContext('2d');

        // Destroy old chart if it exists
        if (purchaseChart) {
            purchaseChart.destroy();
        }

        // Create new chart
        purchaseChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: months,
                datasets: [{
                    label: 'Purchase',
                    data: purchase,
                    backgroundColor: '#28a745'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: false,
                        ticks: {
                            stepSize: 10000,
                            callback: function (value) {
                                return value.toLocaleString();
                            }
                        }
                    }
                }
            }
        });
    }


    function fnIngredientConsumptionReport(itemId) {
        $.ajax({
            url: '/Dashboard/IngredientConsumptionReport',
            type: 'GET',
            data: { itemId: itemId }, // send dropdown selection
            success: function (response) {
                if (response && response.IsSuccess) {
                    var itemNames = [];
                    var consumedQty = [];

                    $.each(response.Data, function (i, item) {
                        itemNames.push(item.Name);
                        consumedQty.push(item.Quantity);
                    });

                    var ctx = document.getElementById('ingredient-chart-canvas').getContext('2d');

                    // Destroy old chart if exists
                    if (ingredientChart) {
                        ingredientChart.destroy();
                    }

                    // Create new chart
                    ingredientChart = new Chart(ctx, {
                        type: 'bar',
                        data: {
                            labels: itemNames,
                            datasets: [{
                                label: 'Consumed Qty (Current Month)',
                                data: consumedQty,
                                backgroundColor: '#ffc107'
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    ticks: {
                                        callback: function (value) {
                                            return value.toLocaleString();
                                        }
                                    },
                                    title: {
                                        display: true,
                                        text: 'Quantity'
                                    }
                                },
                                x: {
                                    title: {
                                        display: true,
                                        text: 'Raw Materials'
                                    }
                                }
                            }
                        }
                    });
                } else {
                    showToastr('error', 'No data found for ingredient consumption.');
                }
            },
            error: function () {
                showToastr('error', 'Error fetching ingredient consumption report.');
            }
        });
    }
</script>
