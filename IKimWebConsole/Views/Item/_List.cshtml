@model IKimWebConsole.Domain.ItemLister

<div class="card-header">
    <a href="javascript:void(0)" class="btn btn-primary add-item float-right">Add Item</a>
</div>

<div class="card-body">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th></th>
                <th>
                    Image
                </th>
                <th>
                    Category
                </th>
                <th>
                    Name
                </th>
                <th>
                    Unit Of Measure
                </th>
                <th>
                    HSN Code
                </th>
                <th>
                    GST
                </th>
                <th>
                    Factory Stock
                </th>
                <th class="text-center">
                    Status
                </th>
                <th colspan="3" class="text-center">
                    Action
                </th>
            </tr>
            <tr>
                <th></th>
                <th></th>
                <th>
                    @Html.TextBoxFor(m => m.SearchCriteria.Category, new { @class = "form-control search-text" })
                </th>
                <th>
                    @Html.TextBoxFor(m => m.SearchCriteria.Name, new { @class = "form-control search-text" })
                </th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th>
                    @Html.DropDownListFor(m => m.SearchCriteria.Status, ViewBag.Status as List<SelectListItem>, "Select Status", new { @class = "form-control search-dropdown" })
                </th>
                <th colspan="3" class="text-center"></th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.List != null && Model.List.Count > default(int))
            {
                foreach (var item in Model.List)
                {
                    var rowId = $"row_{item.Id}";
                    <tr id="@rowId">
                        <td class="text-center align-middle">
                            <a href="javascript:void(0);" data-id="@item.Id" class="toggle-child">
                                <i class="fas fa-plus"></i>
                            </a>
                        </td>
                        <td class="align-middle d-flex justify-content-center" >
                            <img src="data:@item.MimeType;base64,@item.Base64String" alt="Item" style="width: 100px; height: 100px; object-fit: cover; border-radius : 8px" class="img-fluid" />
                        </td>
                        <td class="align-middle">@item.Category</td>
                        <td class="align-middle">@item.Name</td>
                        <td class="align-middle">@item.UnitOfMeasure</td>
                        <td class="align-middle">@item.HSNCode</td>
                        <td class="align-middle">@item.GST</td>
                        <td class="align-middle">@item.FactoryStock</td>
                        <td class="text-center align-middle">
                            @if (item.IsActive)
                            {
                                <span class="badge badge-success">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">Disabled</span>
                            }
                        </td>

                        <td class="text-center align-middle">
                            <a href="javascript:void(0);" data-id="@item.Id" class="icon-stock text-primary"><i class="fas fa-window-restore"></i></a>
                        </td>

                        <td class="text-center align-middle">
                            <a href="javascript:void(0);" data-id="@item.Id" class="icon-edit text-info"><i class="fas fa-edit"></i></a>
                        </td>

                        <td class="text-center align-middle">
                            <a href="javascript:void(0);" data-id="@item.Id" class="icon-delete text-danger"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                    <tr id="child_@item.Id" class="child-row" style="display:none;">
                        <td colspan="11" style="padding:20px;">
                            <div id="childContent_@item.Id">

                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td class="text-center text-danger" colspan="12">
                        There is currently no content to display
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="card-footer">
    <div class="row">
        <div class="col-12">
            <div class="row footer-button-section">
                <div class="col-lg-3 col-xl-3">
                    <div class="page-per-size d-flex align-items-center">
                        @Html.DropDownListFor(m => m.Pagination.PageSize, ViewBag.Pagination as List<SelectListItem> ?? new List<SelectListItem>(), new { @class = "form-control search-pagination set-page-size" })
                        <label>entries per page</label>
                    </div>
                </div>

                <div class="col-lg-4 offset-xl-1 col-xl-3 d-flex justify-content-center align-items-center">
                    <div class="showing-entry d-flex align-items-center">
                        <h3>@Model.Pagination.PaginationSummary </h3>
                    </div>
                </div>
                <div class="col-lg-5 col-xl-5">
                    <div class="navigation-tab">
                        <input type="button" value="First" class="btn btn-secondary navigation" data-direction="First" />
                        <input type="button" value="Previous" class="btn btn-secondary navigation" data-direction="Previous" />
                        <label> @Model.Pagination.CurrentPage / @Model.Pagination.TotalPage</label>
                        <input type="button" value="Next" class="btn btn-secondary navigation" data-direction="Next" />
                        <input type="button" value="Last" class="btn btn-secondary navigation" data-direction="Last" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    @Html.HiddenFor(m => m.Pagination.Skip)
    @Html.HiddenFor(m => m.Pagination.TotalRecord)
</div>
<!-- /.card-footer-->

<script src="@Url.Content("~/custom-js/item/list.js")"></script>

<script>
        window.paginationConfig = {
        pageSize: @Model.Pagination.PageSize,
        totalPage: @Model.Pagination.TotalPage,
        currentPage: @Model.Pagination.CurrentPage,
        skip: @Model.Pagination.Skip,
        };
</script>