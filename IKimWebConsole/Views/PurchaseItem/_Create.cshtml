@model IKimWebConsole.Domain.PurchaseItem

<div class="modal fade" id="modal-purchase-item" tabindex="-1" aria-labelledby="PurchaseItemModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                @if (Model.Id > 0)
                {
                    <h5 class="modal-title fs-5" id="PurchaseItemModalLabel">Edit Purchase Item</h5>
                }
                else
                {
                    <h5 class="modal-title fs-5" id="PurchaseItemModalLabel">Add Purchase Item</h5>
                }
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
            </div>
            <div class="modal-body">
                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(m => m.PurchaseId)
                @Html.HiddenFor(m => m.UnitOfMeasureId)

                <div class="row mb-2">
                    <div class="col">
                        <label>Item <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.ItemId, ViewBag.RawMaterials as List<SelectListItem>, "Select Item", new { @class = "form-control" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col">
                        <label>Rate <span class="text-danger">*</span> </label>
                        @Html.TextBoxFor(m => m.Rate, new { @class = "form-control", placeholder = "Enter Rate" })
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col">
                        <label>Quantity <span class="text-danger">*</span> </label>
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.Qty, new { @class = "form-control qty-error", placeholder = "Enter Quantity" })
                            <div class="input-group-append">
                                @Html.TextBoxFor(m => m.UnitOfMeasure, new { @class = "form-control", @readonly = "readonly", style = "max-width:100px;" })
                            </div>
                        </div>
                        <span class="text-danger"></span>
                        <span class="text-danger qty-error"></span>
                        <span class="text-danger unit-error"></span>
                    </div>
                    <div class="col">
                        <label>Amount <span class="text-danger">*</span> </label>
                        @Html.TextBoxFor(m => m.Amount, new { @class = "form-control", placeholder = "Enter Amount"})
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col">
                        <label>SGST <span class="text-danger">*</span> </label>
                        @Html.TextBoxFor(m => m.SGST, new { @class = "form-control", @readonly = "readonly" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col">
                        <label>CGST <span class="text-danger">*</span> </label>
                        @Html.TextBoxFor(m => m.CGST, new { @class = "form-control", @readonly = "readonly" })
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col">
                        <label>Total Amount <span class="text-danger">*</span> </label>
                        @Html.TextBoxFor(m => m.TotalAmount, new { @class = "form-control", @readonly = "readonly" })
                        <span class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <a href="javascript:void(0);" class="btn btn-primary btn-submit">Submit</a>
            </div>
        </div>
    </div>
</div>

<script src="@Url.Content("~/custom-js/purchase-item/create.js")"></script>

@Html.Hidden("NotificationType", (object)ViewBag.NotificationType)
@Html.Hidden("NotificationMsg", (object)ViewBag.NotificationMsg)